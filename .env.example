# Official MiniMax (no GPU needed)
MINIMAX_API_KEY=
# International: https://api.minimax.io
# China:        https://api.minimaxi.com
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_FAST_MODEL=MiniMax-Hailuo-2.3-Fast
MINIMAX_FAST_RESOLUTION=768P
MINIMAX_MODEL=MiniMax-H3
MINIMAX_RESOLUTION=768P

# CompShare ModelVerse MiniMax-H3 (sk-ml- key from video studio API)
# If set, auto/h3 routing uses this instead of official MiniMax.
COMPSHARE_API_KEY=
COMPSHARE_BASE_URL=https://cp.compshare.cn
COMPSHARE_MODEL=MiniMax-H3
COMPSHARE_RESOLUTION=768P
COMPSHARE_RATIO=9:16
# Public GitHub repo used as image host (jsDelivr). CompShare must fetch a URL.
COMPSHARE_IMAGE_REPO=Tony19940/compshare-h3-tmp

# Self-hosted H3 on a rented 4090 (after you wrap /v1/i2v)
LOCAL_H3_BASE=http://127.0.0.1:8000
LOCAL_H3_TOKEN=

# Volcengine Ark Seedance 2.0 Mini (cloud image-to-video, no local GPU)
# Console: https://console.volcengine.com/ark
# Put the inference endpoint ID in ARK_SEEDANCE_MODEL if the console shows one.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDANCE_MODEL=doubao-seedance-2-0-mini-260615
ARK_RESOLUTION=480p
ARK_GENERATE_AUDIO=0
ARK_WATERMARK=0
# DIRECTOR_VIDEO_BACKEND=seedance


# Grok Imagine stills (pixels). grok-4.6 is text-only and must not be used as an image model.
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Station agents prefer the local Grok/OpenCodex subscription (no XAI_API_KEY needed).
# Default: http://127.0.0.1:10100/v1  model xai/grok-4.6
GROK_SUBSCRIPTION_BASE=http://127.0.0.1:10100/v1
# Set to 1 in tests to force the no-model path.
# DIRECTOR_DISABLE_GROK_SUBSCRIPTION=
# Optional paid xAI key. Only used if the local subscription proxy is down.
XAI_TEXT_MODEL=xai/grok-4.6

# Optional local whisper.cpp model for dialogue timestamps.
WHISPER_MODEL=
WHISPER_ALLOW_TINY=
