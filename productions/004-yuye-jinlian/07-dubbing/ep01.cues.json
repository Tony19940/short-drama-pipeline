      "on_screen_mouth": false,
      "display_zh": "旁白",
      "text_zh": "线长皮萨最爱抓换工位。索菲娅把工号借给萨拉，只求别让她丢工。",
      "caption_zh": "皮萨来了",
      "text_km": "មេខ្សែពិសិដ្ឋ ចូលចិត្តតាមចាប់អ្នកប្តូរកន្លែងធ្វើការជាងគេបំផុត។ សុភាបានឱ្យកាតការងារទៅសារ៉ា ព្រោះតែមិនចង់ឱ្យនាងត្រូវបាត់បង់ការងារ។",
      "caption_km": "មេខ្សែពិសិដ្ឋមកដល់ហើយ!",
      "emotion": "alert",
      "voice_id": null,
      "shots_speaker": "offscreen",
      "display_km": "អ្នកនិទាន"
    },
    {
      "id": "C004",
      "index": 4,
      "shot_id": "SH004",
      "start_ms": 24000,
      "end_ms": 32000,
      "speaker_id": "piseth",
      "speaker_type": "character",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "on_screen_mouth": false,
      "display_zh": "皮萨",
      "text_zh": "谁允许你私自换工位？扣你三天工资，明天不用来了。",
      "caption_zh": "明天不用来了。",
      "text_km": "អ្នកណាអនុញ្ញាតឱ្យឯងប្តូរកន្លែងធ្វើការតាមចិត្ត? កាត់ប្រាក់ខែឯងបីថ្ងៃ ថ្ងៃស្អែកមិនបាច់មកទៀតទេ!",
      "caption_km": "ថ្ងៃស្អែកមិនបាច់មកទៀតទេ!",
      "emotion": "furious",
      "voice_id": null,
      "display_km": "ពិសិដ្ឋ"
    },
    {
      "id": "C005",
      "index": 5,
      "shot_id": "SH005",
      "start_ms": 32000,
      "end_ms": 38000,
      "speaker_id": "sophea",
      "speaker_type": "character",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "on_screen_mouth": false,
      "display_zh": "索菲娅",
      "text_zh": "错在我，我认。孩子病了，不能等。",
      "caption_zh": "孩子病了，不能等。",
      "text_km": "កំហុសមកពីខ្ញុំ ខ្ញុំព្រមទទួល។ តែក្មេងឈឺ មិនអាចបង្អង់បានទេ។",
      "caption_km": "ក្មេងឈឺ មិនអាចបង្អង់បានទេ។",
      "emotion": "holding-tears",
      "voice_id": null,
      "display_km": "សុភា"
    },
    {
