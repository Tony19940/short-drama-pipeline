      "on_screen_mouth": false,
      "display_zh": "旁白",
      "text_zh": "金边夜里，金莲制衣厂还在赶工。厂妹索菲娅的同事萨拉，孩子发着高烧。",
      "caption_zh": "金边·金莲制衣厂",
      "text_km": "នៅភ្នំពេញពេលយប់ រោងចក្រគិនលៀននៅតែបន្តថែមម៉ោង។ សារ៉ាដែលជាមិត្តរួមការងាររបស់កូនកម្មការរោងចក្រសុភា កូនកំពុងតែក្ដៅខ្លួនខ្លាំង។",
      "caption_km": "ភ្នំពេញ · រោងចក្រគិនលៀន",
      "emotion": "crying",
      "voice_id": null,
      "display_km": "អ្នកនិទាន"
    },
    {
      "id": "C002",
      "index": 2,
      "shot_id": "SH002",
      "start_ms": 6000,
      "end_ms": 12000,
      "speaker_id": "sophea",
      "speaker_type": "character",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "on_screen_mouth": false,
      "display_zh": "索菲娅",
      "text_zh": "你去医院。这些校服，我替你做完。",
      "caption_zh": "你去医院。我替你做完。",
      "text_km": "ទៅពេទ្យទៅ។ ឯកសណ្ឋានសាលាទាំងនេះ ខ្ញុំធ្វើជំនួសឱ្យចប់។",
      "caption_km": "ទៅពេទ្យទៅ។ ខ្ញុំធ្វើជំនួសឱ្យចប់។",
      "emotion": "resolute",
      "voice_id": null,
      "display_km": "សុភា"
    },
    {
      "id": "C003",
      "index": 3,
      "shot_id": "SH003",
      "start_ms": 12000,
      "end_ms": 24000,
      "speaker_id": "narrator",
