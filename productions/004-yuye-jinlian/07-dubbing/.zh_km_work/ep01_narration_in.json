  "cues": [
    {
      "index": 1,
      "shot_id": "SH001",
      "window_s": 6,
      "zh": "金边夜里，金莲制衣厂还在赶工。车间里，厂妹索菲娅的同事萨拉坐在车位上哭。孩子发着高烧，这份工却不能丢。"
    },
    {
      "index": 2,
      "shot_id": "SH002",
      "window_s": 6,
      "zh": "于是索菲娅挽起袖子，把没做完的校服拉到自己桌上，让她去医院。"
    },
    {
      "index": 3,
      "shot_id": "SH003",
      "window_s": 12,
      "zh": "可是线长皮萨最爱抓换工位。他从过道深处抱着瑕疵箱走来。"
    },
    {
      "index": 4,
      "shot_id": "SH004",
      "window_s": 8,
      "zh": "当众砸在她脚边，扣了三天工资，明天起开除。"
    },
    {
      "index": 5,
      "shot_id": "SH005",
      "window_s": 6,
      "zh": "索菲娅抬着下巴，眼泪忍着，不跪。错在她，她认；孩子病了，不能等。"
    },
    {
      "index": 6,
      "shot_id": "SH006",
      "window_s": 10,
      "zh": "后来太祖母罗丝路过玻璃走廊。她今晚来看交期，不是来认孙女。"
    },
    {
      "index": 7,
      "shot_id": "SH007",
      "window_s": 8,
      "zh": "可她停住了。那双眼睛，像极了亡媳阿莲。"
    },
    {
      "index": 8,
      "shot_id": "SH008",
      "window_s": 8,
      "zh": "索菲娅领口还挂着半枚莲花银铃。另一半，藏在维拉老宅。"
    }
  ],
