  "cues": [
    {
      "index": 1,
      "speaker_id": "narrator",
      "line_kind": "intro",
      "zh": "金边夜里，金莲制衣厂还在赶工。厂妹索菲娅的同事萨拉，孩子发着高烧。",
      "caption_zh": "金边·金莲制衣厂"
    },
    {
      "index": 2,
      "speaker_id": "sophea",
      "line_kind": "dialogue",
      "zh": "你去医院。这些校服，我替你做完。",
      "caption_zh": "你去医院。我替你做完。"
    },
    {
      "index": 3,
      "speaker_id": "narrator",
      "line_kind": "narration",
      "zh": "线长皮萨最爱抓换工位。索菲娅把工号借给萨拉，只求别让她丢工。",
      "caption_zh": "皮萨来了"
    },
    {
      "index": 4,
      "speaker_id": "piseth",
      "line_kind": "dialogue",
      "zh": "谁允许你私自换工位？扣你三天工资，明天不用来了。",
      "caption_zh": "明天不用来了。"
    },
    {
      "index": 5,
      "speaker_id": "sophea",
      "line_kind": "dialogue",
      "zh": "错在我，我认。孩子病了，不能等。",
      "caption_zh": "孩子病了，不能等。"
    },
    {
      "index": 6,
      "speaker_id": "narrator",
      "line_kind": "narration",
      "zh": "太祖母罗丝是金莲集团的老夫人。她今晚来看交期，不是来认孙女。",
      "caption_zh": "太祖母路过"
    },
    {
      "index": 7,
      "speaker_id": "ros",
      "line_kind": "inner",
      "zh": "这双眼睛……像极了阿莲。",
      "caption_zh": "像极了阿莲"
    },
    {
      "index": 8,
      "speaker_id": "narrator",
      "line_kind": "narration",
      "zh": "索菲娅领口还挂着半枚莲花银铃。另一半，藏在维拉老宅。",
      "caption_zh": "半枚银铃"
    }
  ]
}
