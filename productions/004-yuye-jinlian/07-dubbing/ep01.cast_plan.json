  "cues": [
    {
      "index": 1,
      "id": "C001",
      "shot_id": "SH001",
      "start_ms": 0,
      "end_ms": 6000,
      "speaker_id": "narrator",
      "named_speaker_id": "narrator",
      "gender": "female",
      "line_kind": "intro",
      "delivery": "narration",
      "emotion": "crying",
      "zh_text": "金边夜里，金莲制衣厂还在赶工。厂妹索菲娅的同事萨拉，孩子发着高烧。",
      "km_text": "នៅភ្នំពេញពេលយប់ រោងចក្រគិនលៀននៅតែបន្តថែមម៉ោង។ សារ៉ាដែលជាមិត្តរួមការងាររបស់កូនកម្មការរោងចក្រសុភា កូនកំពុងតែក្ដៅខ្លួនខ្លាំង។",
      "caption_zh": "金边·金莲制衣厂",
      "caption_km": "ភ្នំពេញ · រោងចក្រគិនលៀន"
    },
    {
      "index": 2,
      "id": "C002",
      "shot_id": "SH002",
      "start_ms": 6000,
      "end_ms": 12000,
      "speaker_id": "sophea",
      "named_speaker_id": "sophea",
      "gender": "female",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "emotion": "resolute",
      "zh_text": "你去医院。这些校服，我替你做完。",
      "km_text": "ទៅពេទ្យទៅ។ ឯកសណ្ឋានសាលាទាំងនេះ ខ្ញុំធ្វើជំនួសឱ្យចប់។",
      "caption_zh": "你去医院。我替你做完。",
      "caption_km": "ទៅពេទ្យទៅ។ ខ្ញុំធ្វើជំនួសឱ្យចប់។"
    },
    {
      "index": 3,
      "id": "C003",
      "shot_id": "SH003",
      "start_ms": 12000,
      "end_ms": 24000,
      "speaker_id": "narrator",
      "named_speaker_id": "narrator",
      "gender": "female",
      "line_kind": "narration",
      "delivery": "narration",
      "emotion": "alert",
      "zh_text": "线长皮萨最爱抓换工位。索菲娅把工号借给萨拉，只求别让她丢工。",
      "km_text": "មេខ្សែពិសិដ្ឋ ចូលចិត្តតាមចាប់អ្នកប្តូរកន្លែងធ្វើការជាងគេបំផុត។ សុភាបានឱ្យកាតការងារទៅសារ៉ា ព្រោះតែមិនចង់ឱ្យនាងត្រូវបាត់បង់ការងារ។",
      "caption_zh": "皮萨来了",
      "caption_km": "មេខ្សែពិសិដ្ឋមកដល់ហើយ!"
    },
    {
      "index": 4,
      "id": "C004",
      "shot_id": "SH004",
      "start_ms": 24000,
      "end_ms": 32000,
      "speaker_id": "piseth",
      "named_speaker_id": "piseth",
      "gender": "male",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "emotion": "furious",
      "zh_text": "谁允许你私自换工位？扣你三天工资，明天不用来了。",
      "km_text": "អ្នកណាអនុញ្ញាតឱ្យឯងប្តូរកន្លែងធ្វើការតាមចិត្ត? កាត់ប្រាក់ខែឯងបីថ្ងៃ ថ្ងៃស្អែកមិនបាច់មកទៀតទេ!",
      "caption_zh": "明天不用来了。",
      "caption_km": "ថ្ងៃស្អែកមិនបាច់មកទៀតទេ!"
    },
    {
      "index": 5,
      "id": "C005",
      "shot_id": "SH005",
      "start_ms": 32000,
      "end_ms": 38000,
      "speaker_id": "sophea",
      "named_speaker_id": "sophea",
      "gender": "female",
      "line_kind": "dialogue",
      "delivery": "spoken",
      "emotion": "holding-tears",
      "zh_text": "错在我，我认。孩子病了，不能等。",
      "km_text": "កំហុសមកពីខ្ញុំ ខ្ញុំព្រមទទួល។ តែក្មេងឈឺ មិនអាចបង្អង់បានទេ។",
      "caption_zh": "孩子病了，不能等。",
      "caption_km": "ក្មេងឈឺ មិនអាចបង្អង់បានទេ។"
    },
    {
      "index": 6,
      "id": "C006",
      "shot_id": "SH006",
      "start_ms": 38000,
      "end_ms": 48000,
      "speaker_id": "narrator",
      "named_speaker_id": "narrator",
      "gender": "female",
      "line_kind": "narration",
      "delivery": "narration",
      "emotion": "watchful",
      "zh_text": "太祖母罗丝是金莲集团的老夫人。她今晚来看交期，不是来认孙女。",
      "km_text": "យាយ រ៉ស់ គឺជាលោកស្រីធំនៃក្រុមហ៊ុនគិនលៀន។ យប់នេះគាត់មកពិនិត្យមើលកាលកំណត់ដឹកទំនិញ មិនមែនមកតាមរកចៅស្រីនោះឡើយ។",
      "caption_zh": "太祖母路过",
      "caption_km": "យាយ រ៉ស់ ដើរកាត់ទីនេះ"
    },
    {
      "index": 7,
      "id": "C007",
      "shot_id": "SH007",
      "start_ms": 48000,
      "end_ms": 56000,
      "speaker_id": "ros",
      "named_speaker_id": "ros",
      "gender": "female",
      "line_kind": "inner",
      "delivery": "inner",
      "emotion": "startled-recognition",
      "zh_text": "这双眼睛……像极了阿莲。",
      "km_text": "កែវភ្នែកមួយគូនេះ... ដូចនារីបេះបិទ។",
      "caption_zh": "像极了阿莲",
      "caption_km": "ដូចនារីបេះបិទ"
    },
    {
      "index": 8,
      "id": "C008",
      "shot_id": "SH008",
      "start_ms": 56000,
      "end_ms": 64000,
      "speaker_id": "narrator",
      "named_speaker_id": "narrator",
      "gender": "female",
      "line_kind": "narration",
      "delivery": "narration",
      "emotion": "still",
      "zh_text": "索菲娅领口还挂着半枚莲花银铃。另一半，藏在维拉老宅。",
      "km_text": "នៅត្រង់កអាវរបស់សុភា នៅតែមានពាក់កណ្ដឹងប្រាក់ផ្កាឈូកកន្លះចំហៀង។ ចំណែកពាក់កណ្តាលទៀត គឺលាក់ទុកនៅឯផ្ទះចាស់គ្រួសារវីរ៉ា។",
      "caption_zh": "半枚银铃",
      "caption_km": "កណ្ដឹងប្រាក់កន្លះចំហៀង"
    }
  ]
